// printf test cases, included twice by test/printf.c.
//
//   CASE(name, expected, format, args...)  one printf call; expected is the exact output
//   SPECIAL(name, expected)                hand-written run_<name>() in printf.c
//   SPECIAL_GEN(name)                      run_<name>() and expect_<name>() in printf.c
//   SPECIAL_NOFLUSH(name, expected)        like SPECIAL, but relies on the exit-time flush
//
// The text before the first '_' in a name is its category in the runner's summary.
// Only behaviour that C17 defines (plus wide characters in the C locale) is
// tested; undefined behaviour such as unknown conversions is left out.

// --- Literal text and %% ---
CASE(literal_empty, "", "")
CASE(literal_plain, "hello, world\n", "hello, world\n")
CASE(literal_escapes, "a\tb\nc\n", "a\tb\nc\n")
CASE(literal_high_bytes, "caf\xc3\xa9", "caf\xc3\xa9")
CASE(literal_percent, "%", "%%")
CASE(literal_percent_twice, "%%", "%%%%")
CASE(literal_percent_mid, "100% sure", "100%% sure")
CASE(literal_percent_d, "%d", "%%d")
CASE(literal_percent_then_conv, "%5", "%%%d", 5)
CASE(literal_conv_then_percent, "5%", "%d%%", 5)
CASE(literal_surround, "a1b2c", "a%db%dc", 1, 2)
CASE(literal_adjacent, "12", "%d%d", 1, 2)
CASE(literal_conv_first, "7 apples", "%d apples", 7)
CASE(literal_conv_last, "apples: 7", "apples: %d", 7)
CASE(literal_conv_only, "7", "%d", 7)
CASE(literal_arg_has_percent, "[50%]", "[%s]", "50%")
CASE(literal_arg_has_spec, "%d%s", "%s", "%d%s")
CASE(literal_mixed, "x=1 s=hi c=! 10%", "x=%d s=%s c=%c %d%%", 1, "hi", '!', 10)

